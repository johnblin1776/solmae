# Supabase — required in production for waitlist + Founding 50 applications
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Preferred for server-side inserts (bypasses RLS).
# If unset, the anon key is used and the waitlist / founding_fifty
# insert policies in supabase/migrations/003_waitlist.sql must be applied.
SUPABASE_SERVICE_ROLE_KEY=

# Internal product gate
# Set to "true" to expose /home, /invite, /members, /admin, etc. without a password.
# Leave false/unset in production so those routes 404 unless unlocked.
INTERNAL_ACCESS_ENABLED=false

# Shared password for /internal. Required to unlock product routes
# when INTERNAL_ACCESS_ENABLED is not true. Do not commit the real value.
INTERNAL_GATE_SECRET=

# Optional public links (footer). If unset, Contact uses the in-site page
# and Instagram is omitted from the footer.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_INSTAGRAM_URL=
