# Google Sheet waitlist — required in production
# Apps Script web app URL from scripts/waitlist-sheet-apps-script.js
WAITLIST_SHEET_WEBHOOK_URL=

# Optional. Sent as JSON "secret" and X-Webhook-Secret.
# If set, also add Script property WEBHOOK_SECRET in Apps Script with the same value.
WAITLIST_SHEET_WEBHOOK_SECRET=

# Optional. If unset, Founding 50 uses WAITLIST_SHEET_WEBHOOK_URL (same Apps Script).
FOUNDING_50_SHEET_WEBHOOK_URL=

# Supabase — optional. Not used for waitlist or Founding 50.
# Client helpers remain for later product work.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Internal product gate
# Set to "true" to expose /home, /invite, /members, /admin, etc. without a password.
# Leave false/unset in production so those routes 404 unless unlocked.
INTERNAL_ACCESS_ENABLED=false

# Shared password for /internal. Required to unlock product routes
# when INTERNAL_ACCESS_ENABLED is not true. Do not commit the real value.
INTERNAL_GATE_SECRET=

# Optional public links (footer). If unset, Contact uses the in-site page
# and Instagram is omitted from the footer.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_INSTAGRAM_URL=
